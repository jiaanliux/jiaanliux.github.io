---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { projects, moreWork } from '../data/projects';
import { publications } from '../data/publications';
import { experience, education, talks, skills, awards } from '../data/cv';

import portrait from '../assets/portrait/Jiaan_photo.jpg';
import logoUNU from '../assets/logos/unu-logo.png';
import logoUN from '../assets/logos/UN-logo.png';
import logoITU from '../assets/logos/itu-logo.png';
import logoZJU from '../assets/logos/zju_logo.png';

const logoMap: Record<string, ImageMetadata> = { unu: logoUNU, un: logoUN, itu: logoITU, zju: logoZJU };
const featured = projects.filter((p) => p.featured);
const variants: Array<'feature' | 'left' | 'right'> = ['feature', 'left', 'right', 'feature', 'left', 'right'];
const pubPreview = publications.slice(0, 6);
---

<Base>
  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">{profile.eyebrow}</p>
        <h1 class="hero-name">{profile.name}</h1>
        <p class="hero-pos">{profile.positioning}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#work">See selected work <Icon name="ph:arrow-down" /></a>
          <a class="btn btn-ghost" href="#publications">Publications</a>
        </div>
      </div>
      <div class="hero-portrait reveal">
        <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[320, 520, 720]} sizes="(max-width: 880px) 60vw, 360px" loading="eager" />
      </div>
    </div>
  </section>

  <!-- ============ Stat strip ============ -->
  <section class="stats">
    <div class="wrap stats-grid">
      {
        profile.stats.map((s) => (
          <div class="stat reveal">
            <span class="stat-val">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ About / pillars ============ -->
  <section id="about" class="section">
    <div class="wrap">
      <div class="about-head reveal">
        <h2>Three disciplines, held by one person.</h2>
        <p class="lede">{profile.lede}</p>
      </div>
      <div class="pillars">
        {
          profile.pillars.map((p) => (
            <article class="pillar reveal">
              <span class="pillar-icon"><Icon name={p.icon} /></span>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <ul>
                {p.points.map((pt) => (
                  <li><Icon name="ph:check" /> {pt}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="affil reveal">
        <span class="affil-label">Affiliations</span>
        <div class="affil-logos">
          {profile.affiliations.map((a) => <img src={logoMap[a.logo].src} alt={a.name} title={a.name} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Selected work ============ -->
  <section id="work" class="section section-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">Selected work</p>
        <h2>Research and systems, shipped.</h2>
      </div>
      <div class="work-list">
        {featured.map((p, i) => <ProjectCard project={p} variant={variants[i] ?? 'left'} />)}
      </div>

      <div class="more reveal">
        <h3 class="more-title">More work</h3>
        <div class="more-grid">
          {
            moreWork.map((m) => (
              <article class="more-card">
                <p class="kicker">{m.category}</p>
                <h4>{m.title}</h4>
                <p class="more-note">{m.note}</p>
                {m.links[0] && (
                  <a class="more-link" href={m.links[0].href} target="_blank" rel="noopener">
                    {m.links[0].label} <Icon name="ph:arrow-up-right" />
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <p class="more-all"><a class="link-underline" href="/projects">All projects <Icon name="ph:arrow-right" /></a></p>
      </div>
    </div>
  </section>

  <!-- ============ Publications ============ -->
  <section id="publications" class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>Selected publications.</h2>
        <p class="lede">Peer-reviewed research across agentic AI, remote sensing, and environmental science, including two Q1 journals and a Best Paper award.</p>
      </div>
      <ol class="pubs">
        {
          pubPreview.map((pub) => (
            <li class="pub reveal">
              <span class="pub-year">{pub.year}</span>
              <div class="pub-body">
                <p class="pub-title">
                  {pub.href ? <a href={pub.href} target="_blank" rel="noopener" class="link-underline">{pub.title}</a> : pub.title}
                </p>
                <p class="pub-meta" set:html={pub.authors.replace('Liu, J.', '<strong>Liu, J.</strong>')} />
                <p class="pub-venue">{pub.venue}</p>
                {pub.badges && (
                  <div class="pub-badges">{pub.badges.map((b) => <span class="chip chip-accent">{b}</span>)}</div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="more-all"><a class="link-underline" href="/publications">All publications <Icon name="ph:arrow-right" /></a></p>
    </div>
  </section>

  <!-- ============ Speaking ============ -->
  <section id="speaking" class="section section-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">Speaking &amp; engagement</p>
        <h2>Carrying the work into the room.</h2>
      </div>
      <div class="talks">
        {
          talks.map((g) => (
            <div class="talk-group reveal">
              <h3>{g.heading}</h3>
              <ul>
                {g.items.map((t) => <li><Icon name="ph:microphone-stage" /> <span>{t}</span></li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Experience & education ============ -->
  <section id="experience" class="section">
    <div class="wrap exp-grid">
      <div class="exp-col reveal">
        <h2>Experience</h2>
        <ol class="timeline">
          {
            experience.map((r) => (
              <li class="tl-item">
                <div class="tl-head">
                  <span class="tl-org">{r.org}</span>
                  <span class="tl-period">{r.period}</span>
                </div>
                <p class="tl-title">{r.title} <span class="tl-loc">· {r.location}</span></p>
                <ul class="tl-points">{r.points.map((pt) => <li>{pt}</li>)}</ul>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="exp-col reveal">
        <h2>Education</h2>
        <ol class="timeline">
          {
            education.map((e) => (
              <li class="tl-item">
                <div class="tl-head">
                  <span class="tl-org">{e.org}</span>
                  <span class="tl-period">{e.period}</span>
                </div>
                <p class="tl-title">{e.degree}</p>
                <p class="tl-detail">{e.detail}</p>
              </li>
            ))
          }
        </ol>

        <h3 class="awards-h">Awards &amp; honors</h3>
        <ul class="awards">{awards.map((a) => <li><Icon name="ph:seal-check" /> <span>{a}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ============ Skills ============ -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="sec-head reveal"><h2>Toolkit.</h2></div>
      <div class="skills">
        {
          skills.map((g) => (
            <div class="skill-group reveal">
              <h3>{g.heading}</h3>
              <ul>{g.items.map((s) => <li class="chip">{s}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Contact ============ -->
  <section id="contact" class="section">
    <div class="wrap contact reveal">
      <p class="kicker">Get in touch</p>
      <h2 class="contact-h">Open to research collaboration, advisory, and applied AI work in the UN system and beyond.</h2>
      <div class="contact-links">
        <a class="btn btn-primary" href={profile.links.linkedin} target="_blank" rel="noopener">
          <Icon name="ph:linkedin-logo" /> Connect on LinkedIn
        </a>
        <a class="btn btn-ghost" href={profile.links.unu} target="_blank" rel="noopener">
          <Icon name="ph:identification-card" /> UNU profile
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .section-alt { background: var(--color-surface); border-block: 1px solid var(--color-line); }
  .sec-head { margin-bottom: 2.75rem; max-width: 60ch; }
  .sec-head h2, .about-head h2 { font-size: var(--step-3); margin: 0.4rem 0 0.6rem; }

  /* Hero */
  .hero { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2rem, 4vw, 3rem); }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  .hero-name { font-size: var(--step-5); margin: 0.6rem 0 0; line-height: 0.98; }
  .hero-pos {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--color-ink-soft);
    margin: 1.1rem 0 0;
    max-width: 22ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero-cta :global(svg) { width: 1rem; height: 1rem; }
  .hero-portrait {
    justify-self: start;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-line);
    max-width: 320px;
  }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 880px) {
    .hero-grid { grid-template-columns: 1.55fr 1fr; gap: 4rem; }
    .hero-portrait { justify-self: end; max-width: 360px; }
  }

  /* Stat strip */
  .stats { border-block: 1px solid var(--color-line); background: var(--color-paper); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    padding-block: 2rem;
  }
  .stat { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-val { font-family: var(--font-display); font-size: var(--step-3); color: var(--color-accent); line-height: 1; }
  .stat-label { font-size: 0.85rem; color: var(--color-ink-soft); }
  @media (min-width: 760px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  /* Pillars */
  .pillars { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .pillar { background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 1.75rem; }
  .pillar-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; border-radius: var(--radius);
    background: var(--color-accent-tint); color: var(--color-accent); margin-bottom: 1rem;
  }
  .pillar-icon :global(svg) { width: 1.5rem; height: 1.5rem; }
  .pillar h3 { font-size: var(--step-1); margin: 0 0 0.5rem; }
  .pillar > p { color: var(--color-ink-soft); margin: 0 0 1rem; font-size: 0.95rem; }
  .pillar ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .pillar li { display: flex; gap: 0.5rem; font-size: 0.9rem; color: var(--color-ink-soft); }
  .pillar li :global(svg) { width: 1rem; height: 1rem; color: var(--color-accent); flex-shrink: 0; margin-top: 0.28rem; }
  @media (min-width: 880px) { .pillars { grid-template-columns: repeat(3, 1fr); } }

  /* Affiliations */
  .affil { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-line); }
  .affil-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-faint); }
  .affil-logos { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.25rem; }
  .affil-logos img { height: 38px; width: auto; opacity: 0.85; filter: saturate(0.9); }

  /* Selected work */
  .work-list { display: grid; gap: clamp(3rem, 6vw, 5rem); }

  .more { margin-top: clamp(3.5rem, 6vw, 5rem); padding-top: 2.5rem; border-top: 1px solid var(--color-line); }
  .more-title { font-size: var(--step-1); margin: 0 0 1.5rem; }
  .more-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  .more-card { background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 1.4rem; }
  .more-card h4 { font-size: 1.1rem; margin: 0.4rem 0 0.5rem; }
  .more-note { font-size: 0.88rem; color: var(--color-ink-soft); margin: 0 0 0.75rem; }
  .more-link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.85rem; color: var(--color-accent); }
  .more-link :global(svg) { width: 0.85rem; height: 0.85rem; }
  .more-all { margin-top: 2rem; }
  .more-all a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 500; color: var(--color-accent); }
  .more-all :global(svg) { width: 1rem; height: 1rem; }
  @media (min-width: 720px) { .more-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .more-grid { grid-template-columns: repeat(3, 1fr); } }

  /* Publications */
  .pubs { list-style: none; padding: 0; margin: 0; }
  .pub { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.5rem 0; border-top: 1px solid var(--color-line); }
  .pub:last-child { border-bottom: 1px solid var(--color-line); }
  .pub-year { font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-ink-faint); padding-top: 0.2rem; }
  .pub-title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.3; margin: 0 0 0.35rem; }
  .pub-meta { font-size: 0.85rem; color: var(--color-ink-soft); margin: 0 0 0.2rem; }
  .pub-meta :global(strong) { color: var(--color-ink); }
  .pub-venue { font-size: 0.85rem; color: var(--color-ink-faint); margin: 0; }
  .pub-badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }

  /* Speaking */
  .talks { display: grid; gap: 2.5rem; }
  .talk-group h3 { font-size: var(--step-1); margin: 0 0 1rem; }
  .talk-group ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .talk-group li { display: flex; gap: 0.6rem; color: var(--color-ink-soft); font-size: 0.95rem; }
  .talk-group li :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--color-accent); flex-shrink: 0; margin-top: 0.2rem; }
  @media (min-width: 880px) { .talks { grid-template-columns: 1fr 1fr; gap: 3.5rem; } }

  /* Experience & education */
  .exp-grid { display: grid; gap: 3rem; }
  .exp-col h2 { font-size: var(--step-2); margin: 0 0 1.75rem; }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.75rem; }
  .tl-item { padding-left: 1.25rem; border-left: 2px solid var(--color-accent-tint-2); }
  .tl-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
  .tl-org { font-weight: 600; }
  .tl-period { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink-faint); }
  .tl-title { margin: 0.2rem 0 0.5rem; color: var(--color-ink-soft); font-size: 0.92rem; }
  .tl-loc { color: var(--color-ink-faint); }
  .tl-detail { margin: 0; color: var(--color-ink-soft); font-size: 0.9rem; }
  .tl-points { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .tl-points li { color: var(--color-ink-soft); font-size: 0.9rem; }
  .awards-h { font-size: var(--step-1); margin: 2.5rem 0 1rem; }
  .awards { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .awards li { display: flex; gap: 0.6rem; font-size: 0.92rem; color: var(--color-ink-soft); }
  .awards li :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--color-accent); flex-shrink: 0; margin-top: 0.2rem; }
  @media (min-width: 880px) { .exp-grid { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }

  /* Skills */
  .skills { display: grid; gap: 1.75rem; }
  .skill-group h3 { font-size: 1rem; margin: 0 0 0.75rem; }
  .skill-group ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  @media (min-width: 760px) { .skills { grid-template-columns: repeat(2, 1fr); gap: 2rem 3rem; } }
  @media (min-width: 1040px) { .skills { grid-template-columns: repeat(3, 1fr); } }

  /* Contact */
  .contact { max-width: 60rem; }
  .contact-h { font-size: var(--step-3); margin: 0.6rem 0 1.75rem; max-width: 24ch; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .contact-links :global(svg) { width: 1.1rem; height: 1.1rem; }
</style>
